# MailRadar Configuration
APP_NAME=MailRadar
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars!
FERNET_KEY=Z3B2Q21RNGV2dmtIUVc2a2F1ckFvUTVwSG9XUlpVbmM=

# Database
# For Docker / PostgreSQL: postgresql+psycopg2://mailradar:mailradar_pass@localhost:5432/mailradar
# For Local Development / SQLite: sqlite:///./mailradar.db
DATABASE_URL=sqlite:///./mailradar.db

# Redis & Workers
REDIS_URL=redis://localhost:6379/0

# GitHub Integration (Personal Access Token or Fine-Grained Token)
GITHUB_API_TOKEN=

# Outbound Email Delivery Provider (sandbox or smtp)
DELIVERY_PROVIDER=sandbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outreach@mailradar.dev
SMTP_USE_TLS=false

# CORS & Server
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000
